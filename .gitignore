# Kredensial & config asli — jangan pernah commit (isi dengan API key/token nyata)
openclaw.json

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Backup & export otomatis (data pribadi keluarga, dibuat ulang oleh backup.sh)
data/backups/*

# Local Claude Code settings (khusus environment lokal)
.claude/settings.local.json

# Catatan transaksi keluarga — data pribadi, jangan pernah commit.
# Bentuk kolomnya ada di data/bills.csv.example (header saja), pola yang sama
# dipakai openclaw.json / openclaw.json.example untuk kredensial.
data/bills.csv
data/*.bak

# Kewajiban (tagihan belum dibayar) & Perkiraan (transaksi berulang) — sama-sama
# memuat nominal (gaji, premi, langganan), jadi diperlakukan seperti bills.csv.
# Bentuknya ada di pasangan *.example yang dilacak. Lihat docs/adr/0004 & 0006.
data/kewajiban.json
data/perkiraan.json

# Artefak workspace OpenClaw — state lokal mesin & data pribadi yang menumpuk
# (USER.md profil pengguna, TOOLS.md host SSH, media/ foto struk masuk)
media/
openclaw-workspace-state.json
USER.md
TOOLS.md
SOUL.md
IDENTITY.md
HEARTBEAT.md
# Catatan harian agent — memuat saldo sungguhan & nama anggota keluarga
memory/

# Jejak peredam peringatan penjaga kesehatan (keadaan operasional, ADR-0011)
data/kesehatan-terakhir.json

# Saldo awal tiap akun — nominal sungguhan, diperlakukan seperti bills.csv.
# Bentuknya ada di data/akun.json.example, yang angkanya sengaja dikarang.
# Lihat docs/adr/0010.
data/akun.json

# Angka yang pernah dilaporkan Laporan Bulanan — nominal sungguhan, dasar Koreksi.
# Keadaan operasional, dibuat scripts/laporan-bulanan.py --kirim. Lihat docs/adr/0012.
data/laporan-bulanan.json
